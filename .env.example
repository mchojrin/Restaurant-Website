# Local development defaults for `docker compose`.
# Copy this file to `.env` (cp .env.example .env) and adjust as needed.

# Host port that http://localhost:<APP_PORT>/ is served on.
APP_PORT=8080

# MySQL/MariaDB database name; created automatically on first startup.
DB_NAME=food_order
DB_USER=food_user
DB_PASSWORD=food_password

# Only used inside the database container (never exposed to the host).
DB_ROOT_PASSWORD=dev_root_password

# Base URL used to build links and image URLs.
# "/" is root-relative and works on any host/port (recommended for Docker).
# Use a full URL instead if absolute links are required, e.g.:
#   SITEURL=http://localhost:8080/
SITEURL=/
